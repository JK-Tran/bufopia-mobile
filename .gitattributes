# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Source code and config files
*.dart text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.arb text eol=lf
*.xml text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

# Scripts
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mp3 binary
*.wav binary
*.ogg binary
*.jar binary
*.keystore binary
*.jks binary
